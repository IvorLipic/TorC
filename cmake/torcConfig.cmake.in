@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The library links OpenMP privately when built with USE_OPENMP, but the exported target still
# records it as a link-only dependency, so consumers must be able to find it.
if(@USE_OPENMP@)
    find_dependency(OpenMP)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/torcTargets.cmake")

check_required_components(torc)
